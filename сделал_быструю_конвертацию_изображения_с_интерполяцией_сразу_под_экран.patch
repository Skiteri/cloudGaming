--- /dev/null	(date 1787060439954)
+++ b/drawer/src/main/resources/capture.cpp	(date 1787060439954)
@@ -0,0 +1,155 @@
+// ConsoleApplication1.cpp : Этот файл содержит функцию "main". Здесь начинается и заканчивается выполнение программы.
+//
+
+#include <d3d11.h>
+#include <dxgi1_2.h>
+#include <iostream>
+#include <chrono>
+#include <jni.h>
+#include "NativeScreenCaptureService.h"
+
+
+using namespace std;
+
+#pragma comment(lib, "d3d11.lib")
+#pragma comment(lib, "dxgi.lib")
+
+
+JNIEXPORT jbyteArray JNICALL Java_NativeScreenCaptureService_capture(JNIEnv* env, jobject obj, jint a, jint b) {
+    HRESULT hr;
+    jbyteArray result = nullptr;
+
+    // 1. Создаем устройство D3D11
+    ID3D11Device* d3dDevice = nullptr;
+    ID3D11DeviceContext* d3dContext = nullptr;
+    D3D_FEATURE_LEVEL featureLevel;
+
+    hr = D3D11CreateDevice(
+        nullptr,
+        D3D_DRIVER_TYPE_HARDWARE,
+        nullptr,
+        0,
+        nullptr,
+        0,
+        D3D11_SDK_VERSION,
+        &d3dDevice,
+        &featureLevel,
+        &d3dContext
+    );
+
+    if (FAILED(hr)) {
+        return nullptr;
+    }
+
+    // 2. Получаем DXGI интерфейсы
+    IDXGIDevice* dxgiDevice = nullptr;
+    d3dDevice->QueryInterface(__uuidof(IDXGIDevice), (void**)&dxgiDevice);
+
+    IDXGIAdapter* dxgiAdapter = nullptr;
+    dxgiDevice->GetParent(__uuidof(IDXGIAdapter), (void**)&dxgiAdapter);
+
+    IDXGIOutput* dxgiOutput = nullptr;
+    dxgiAdapter->EnumOutputs(0, &dxgiOutput);
+
+    IDXGIOutput1* dxgiOutput1 = nullptr;
+    dxgiOutput->QueryInterface(__uuidof(IDXGIOutput1), (void**)&dxgiOutput1);
+
+    // 3. Активируем Desktop Duplication
+    IDXGIOutputDuplication* deskDupl = nullptr;
+    hr = dxgiOutput1->DuplicateOutput(d3dDevice, &deskDupl);
+
+    if (FAILED(hr)) {
+        // Очистка при ошибке
+        dxgiOutput1->Release();
+        dxgiOutput->Release();
+        dxgiAdapter->Release();
+        dxgiDevice->Release();
+        d3dContext->Release();
+        d3dDevice->Release();
+        return nullptr;
+    }
+
+    // 4. Захватываем кадр
+    DXGI_OUTDUPL_FRAME_INFO frameInfo;
+    IDXGIResource* desktopResource = nullptr;
+
+    hr = deskDupl->AcquireNextFrame(500, &frameInfo, &desktopResource);
+
+    if (SUCCEEDED(hr)) {
+        // Получаем текстуру
+        ID3D11Texture2D* gpuTexture = nullptr;
+        desktopResource->QueryInterface(__uuidof(ID3D11Texture2D), (void**)&gpuTexture);
+
+        // Получаем описание текстуры
+        D3D11_TEXTURE2D_DESC desc;
+        gpuTexture->GetDesc(&desc);
+
+        // Создаем текстуру для копирования в CPU
+        D3D11_TEXTURE2D_DESC stagingDesc = desc;
+        stagingDesc.Usage = D3D11_USAGE_STAGING;
+        stagingDesc.BindFlags = 0;
+        stagingDesc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        stagingDesc.MiscFlags = 0;
+
+        ID3D11Texture2D* stagingTexture = nullptr;
+        hr = d3dDevice->CreateTexture2D(&stagingDesc, nullptr, &stagingTexture);
+
+        if (SUCCEEDED(hr)) {
+            // Копируем из GPU текстуры в staging текстуру
+            d3dContext->CopyResource(stagingTexture, gpuTexture);
+
+            // Получаем доступ к данным на CPU
+            D3D11_MAPPED_SUBRESOURCE mapped;
+            hr = d3dContext->Map(stagingTexture, 0, D3D11_MAP_READ, 0, &mapped);
+
+            if (SUCCEEDED(hr)) {
+                // Вычисляем размер данных
+                int width = desc.Width;
+                int height = desc.Height;
+                int bytesPerPixel = 4; // BGRA
+                int imageSize = width * height * bytesPerPixel;
+
+                // Создаем Java byte[]
+                result = env->NewByteArray(imageSize);
+
+                if (result != nullptr) {
+                    // Получаем указатель на Java массив
+                    jbyte* byteArray = env->GetByteArrayElements(result, nullptr);
+
+                    // Копируем данные из GPU в Java массив
+                    // mapped.pData содержит данные в формате BGRA
+                    // mapped.RowPitch - количество байтов в строке (может быть шире из-за выравнивания)
+
+                    for (int y = 0; y < height; y++) {
+                        const BYTE* srcRow = static_cast<const BYTE*>(mapped.pData) + y * mapped.RowPitch;
+                        jbyte* dstRow = byteArray + y * width * bytesPerPixel;
+                        memcpy(dstRow, srcRow, width * bytesPerPixel);
+                    }
+
+                    // Освобождаем Java массив
+                    env->ReleaseByteArrayElements(result, byteArray, 0);
+                }
+
+                d3dContext->Unmap(stagingTexture, 0);
+            }
+
+            stagingTexture->Release();
+        }
+
+        gpuTexture->Release();
+        desktopResource->Release();
+        deskDupl->ReleaseFrame();
+    }
+
+    // Очистка
+    deskDupl->Release();
+    dxgiOutput1->Release();
+    dxgiOutput->Release();
+    dxgiAdapter->Release();
+    dxgiDevice->Release();
+    d3dContext->Release();
+    d3dDevice->Release();
+
+    return result;
+}
+
